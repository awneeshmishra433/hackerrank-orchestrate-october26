# Environment Configuration for Ghost Data Still Exists Deletion Audit Agent
# Copy this file to .env and configure keys if running external model extraction.

# LLM / Multimodal API Keys (Optional - deterministic offline extractors handle standard execution)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dataset and Evidence Paths
DATASET_DIR=dataset
DEFAULT_INPUT=dataset/deletion_requests.csv
DEFAULT_OUTPUT=output.csv

# Logging Configuration
LOG_LEVEL=INFO

